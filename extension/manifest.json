{
  "manifest_version": 3,
  "name": "Navy",
  "version": "0.1.1",
  "author": "Zrnge",
  "homepage_url": "https://github.com/zrnge/navybrowser",
  "description": "AI browser automation agent. Private with Ollama or LM Studio. When using cloud providers, page content is sent to their API.",

  "icons": {
    "16": "ui/icon16.png",
    "48": "ui/icon48.png",
    "128": "ui/icon128.png"
  },

  "permissions": [
    "alarms",
    "debugger",
    "scripting",
    "sidePanel",
    "tabs",
    "activeTab",
    "storage",
    "tabGroups",
    "clipboardWrite",
    "clipboardRead",
    "downloads",
    "tabCapture",
    "offscreen",
    "bookmarks",
    "history"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Navy",
    "default_icon": {
      "16": "ui/icon16.png",
      "48": "ui/icon48.png",
      "128": "ui/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "ui/panel.html"
  },

  "commands": {
    "panic-stop": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Panic stop — immediately abort any running agent task"
    },
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open/close the agent side panel"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://api.deepseek.com https://api.x.ai https://api.z.ai https://api.groq.com https://openrouter.ai http://127.0.0.1:* http://localhost:*;"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["canvas-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],

  "minimum_chrome_version": "116"
}
