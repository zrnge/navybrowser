{
  "manifest_version": 3,
  "name": "Navy",
  "version": "0.1.0",
  "author": "Zrnge",
  "homepage_url": "https://github.com/zrnge/navybrowser",
  "description": "Local AI browser automation agent. Fully private with Ollama or LM Studio. When using cloud AI providers, page content is sent to your chosen provider to complete tasks.",

  "icons": {
    "16": "ui/icon16.png",
    "48": "ui/icon48.png",
    "128": "ui/icon128.png"
  },

  "permissions": [
    "debugger",
    "scripting",
    "sidePanel",
    "tabs",
    "activeTab",
    "storage",
    "tabGroups",
    "clipboardWrite",
    "downloads",
    "tabCapture",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Navy",
    "default_icon": {
      "16": "ui/icon16.png",
      "48": "ui/icon48.png",
      "128": "ui/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "ui/panel.html"
  },

  "commands": {
    "panic-stop": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Panic stop — immediately abort any running agent task"
    },
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open/close the agent side panel"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },

  "minimum_chrome_version": "116"
}
